#version 460 core

// One level of a coarse-to-fine block-matching optical flow.
//
// Motion convention: for every pixel x of the current frame the shader finds the offset m such
// that PreviousLuma(x + m) matches CurrentLuma(x), in pixels of this level. The result is stored
// as (m.x, m.y, matching cost of m, matching cost of zero motion).
//
// The coarsest level searches from zero. Every finer level starts from the parent level's vector
// (doubled, since a pixel is half the size) and from the parent vectors of the neighbouring
// parent texels, then refines around the best of them with a shrinking step. The first step per
// level is chosen by the caller, so a large motion is found cheaply on the small levels and the
// full-size level only refines. A candidate is scored on a five-tap luma cross, and the sub-pixel
// steps use the sampler's bilinear filter.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D CurrentLuma;
layout(binding = 1) uniform sampler2D PreviousLuma;
layout(binding = 2) uniform sampler2D ParentFlow;
layout(binding = 3, rgba16f) uniform writeonly image2D OutFlow;

layout(push_constant) uniform PushConstants {
    vec2 inv_render_size; // of this level
    vec2 render_size;     // of this level
    float first_step;     // first refinement step in pixels of this level
    float min_step;       // last refinement step
    float smoothness;     // score penalty per pixel of motion
    float has_parent;     // 1.0 when ParentFlow holds the next coarser level
};

const ivec2 TAPS[5] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));

const vec2 DIRECTIONS[8] = vec2[](vec2(-1.0, -1.0), vec2(0.0, -1.0), vec2(1.0, -1.0),
                                  vec2(-1.0, 0.0), vec2(1.0, 0.0),
                                  vec2(-1.0, 1.0), vec2(0.0, 1.0), vec2(1.0, 1.0));

float g_current_luma[5];

// Mean absolute luma difference between the current cross and the previous frame displaced by
// 'candidate'.
float matchCost(vec2 uv, vec2 candidate) {
    float sum = 0.0;
    for (int i = 0; i < 5; ++i) {
        vec2 p = uv + (candidate + vec2(TAPS[i])) * inv_render_size;
        sum += abs(g_current_luma[i] - texture(PreviousLuma, p).r);
    }
    return sum * 0.2;
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(render_size.x) || pixel_coord.y >= int(render_size.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * inv_render_size;
    for (int i = 0; i < 5; ++i) {
        g_current_luma[i] = texture(CurrentLuma, uv + vec2(TAPS[i]) * inv_render_size).r;
    }

    // Static pixels need no search.
    float zero_cost = matchCost(uv, vec2(0.0));
    if (zero_cost < 0.004) {
        imageStore(OutFlow, pixel_coord, vec4(0.0, 0.0, zero_cost, zero_cost));
        return;
    }

    vec2 best = vec2(0.0);
    float best_cost = zero_cost;
    float best_score = zero_cost;

    if (has_parent > 0.5) {
        // The parent vector at this pixel, and at the four parent texels around it: a vector
        // across a motion boundary is often right in a neighbouring texel only.
        vec2 parent_texel = 1.0 / vec2(textureSize(ParentFlow, 0));
        const vec2 OFFSETS[5] = vec2[](vec2(0.0), vec2(-1.0, -1.0), vec2(1.0, -1.0),
                                       vec2(-1.0, 1.0), vec2(1.0, 1.0));
        for (int i = 0; i < 5; ++i) {
            vec2 candidate = 2.0 * texture(ParentFlow, uv + OFFSETS[i] * 0.5 * parent_texel).xy;
            float cost = matchCost(uv, candidate);
            float score = cost + smoothness * length(candidate);
            if (score < best_score) {
                best_score = score;
                best_cost = cost;
                best = candidate;
            }
        }
    }

    for (float step_size = first_step; step_size >= min_step; step_size *= 0.5) {
        vec2 center = best;
        for (int d = 0; d < 8; ++d) {
            vec2 candidate = center + DIRECTIONS[d] * step_size;
            float cost = matchCost(uv, candidate);
            float score = cost + smoothness * length(candidate);
            if (score < best_score) {
                best_score = score;
                best_cost = cost;
                best = candidate;
            }
        }
        // A near-perfect match cannot be improved by refining.
        if (best_cost < 0.003) {
            break;
        }
    }

    imageStore(OutFlow, pixel_coord, vec4(best, best_cost, zero_cost));
}
