#version 460 core

// Synthesises a frame at time blend_factor between PreviousFrame (0.0) and CurrentFrame (1.0).
//
// MotionVectors is the median-filtered flow (fsr3_flow_median.comp): per current-frame pixel x,
// the offset m (in flow-image pixels) such that PreviousFrame(x + m) matches CurrentFrame(x). The
// object seen at x in the current frame was at x + m in the previous one, so the pixel at uv of the
// intermediate frame comes from PreviousFrame(uv + m * t) and CurrentFrame(uv - m * (1 - t)).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D CurrentFrame;
layout(binding = 1) uniform sampler2D PreviousFrame;
layout(binding = 2) uniform sampler2D MotionVectors;
layout(binding = 3, rgba8) uniform writeonly image2D OutGeneratedFrame;

layout(push_constant) uniform PushConstants {
    vec2 inv_render_size;
    vec2 render_size;
    float blend_factor; // timestamp between 0.0 (previous) and 1.0 (current)
    float reserved;
};

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(render_size.x) || pixel_coord.y >= int(render_size.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * inv_render_size;
    float t = blend_factor;

    // One bilinear fetch of the filtered flow: x, y in flow pixels, then the matching cost.
    vec4 flow = texture(MotionVectors, uv);
    vec2 flow_pixels = flow.xy;
    float match_cost = flow.z;

    // Flow pixels to uv units of the (full resolution) frames.
    vec2 motion = flow_pixels / vec2(textureSize(MotionVectors, 0));

    vec4 previous_color = texture(PreviousFrame, uv + motion * t);
    vec4 current_color = texture(CurrentFrame, uv - motion * (1.0 - t));
    vec4 warped = mix(previous_color, current_color, t);

    // The flow is unreliable where the block match was poor or where the two warped samples
    // disagree (occlusions, scene cuts). Static pixels are always reliable: a cross-fade of two
    // identical or slowly changing pixels is the right answer for them.
    float color_diff = dot(abs(previous_color.rgb - current_color.rgb), vec3(1.0 / 3.0));
    float reliability = (1.0 - smoothstep(0.05, 0.20, match_cost)) *
                        (1.0 - smoothstep(0.12, 0.40, color_diff));
    float moving = smoothstep(0.1, 0.5, length(flow_pixels));
    reliability = mix(1.0, reliability, moving);

    // Unreliable pixels take the nearer frame instead of a ghosted cross-fade.
    float nearest = smoothstep(0.35, 0.65, t);
    vec4 fallback = mix(texture(PreviousFrame, uv), texture(CurrentFrame, uv), nearest);

    imageStore(OutGeneratedFrame, pixel_coord, vec4(mix(fallback, warped, reliability).rgb, 1.0));
}
